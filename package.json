{
  "name": "softfolk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm test:dist"
  },
  "devDependencies": {
    "@types/node": "24.9.2",
    "happy-dom": "20.8.4",
    "typescript": "5.9.2",
    "vite": "8.2.1",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "4.1.10"
  }
}
